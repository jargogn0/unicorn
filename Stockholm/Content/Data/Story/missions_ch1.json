      "giver": "noor",
      "auto_start": true,
      "prerequisites": {
        "mission": "m01_show_me",
        "status": "completed"
      },
      "on_start": [
        {
          "world_event": "weather:heavy_snow",
          "text": "Heavy snow forecast across Stockholm."
        }
      ],
      "objectives": [
        {
          "id": "o1",
          "type": "decision",
          "text": "How will you get to Kungsholmen?",
          "target": "",
          "options": [
            {
              "id": "car",
              "text": "Borrow Sami's Volvo",
              "next": "o1_sami"
            },
            {
              "id": "transit",
              "text": "Tunnelbana and walk (cheap, slower)",
