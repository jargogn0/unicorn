              "if": {
                "fact": "has_sami_car"
              },
              "next": "o8"
            }
          ],
          "next": "@complete"
        },
        {
          "id": "o8",
          "type": "drive",
          "text": "Fill the tank and return Sami's car by 20:00",
          "target": "sami_car_spot",
          "deadline": "20:00",
          "on_start": [
            {
              "add_stat": "personal_cash",
              "value": -310
            }
          ],
          "on_complete": [
            {
              "fulfil": "sami_car"
            },
            {
              "world_event": "despawn_vehicle:sami_volvo"
            }
          ],
          "on_fail": [
            {
              "world_event": "despawn_vehicle:sami_volvo"
            }
          ],
          "fail_next": "@complete",
          "next": "@complete"
        }
      ],
      "on_complete": [
