              ],
              "next": "o7"
            },
            {
              "id": "reschedule",
              "text": "Apologise and ask to reschedule",
              "effects": [
                {
                  "set_fact": "lost_contract"
                }
              ],
              "next": "o7"
            }
          ],
          "next": "o7"
        },
        {
          "id": "o6_fix",
          "type": "custom",
          "text": "Get the demo running again (offline cache, restart the sync)",
