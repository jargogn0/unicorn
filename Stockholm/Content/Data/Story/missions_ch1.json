                {
                  "set_fact": "company_form",
                  "value": 2
                },
                {
                  "add_stat": "personal_cash",
                  "value": -26900
                },
                {
                  "add_stat": "company_cash",
                  "value": 25000
                }
              ]
            },
            {
              "id": "service",
              "text": "Use an invoicing service — no registration, they keep 6 %",
