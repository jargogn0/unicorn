    {
      "id": "m00_five_days",
      "chapter": 1,
      "title": "Five Days",
      "summary": "Snow outside. Rent due in five days. A message from someone who wants to see what you're building.",
      "giver": "noor",
      "auto_start": true,
      "prerequisites": null,
      "on_start": [
        {
          "company_name": "OctOpus"
        },
        {
          "product_name": "OctOpus Forecast"
        },
        {
          "world_event": "cinematic:opening",
          "text": "Snow falling outside. A phone lights up."
        },
        {
          "message": {
            "from": "bank",
            "text": "Reminder: rent 9 400 SEK due in 5 days. Balance: 4 200 SEK."
          }
        },
        {
          "message": {
            "from": "noor",
            "text": "Hey. Heard you're building something. Can you show me?"
          }
        }
      ],
      "objectives": [
        {
          "id": "o1",
          "type": "phone_call",
          "text": "Reply to the message",
          "target": "phone",
          "dialogue": "opening_phone",
          "next": "o2"
        },
        {
          "id": "o2",
          "type": "interact",
          "text": "Grab your laptop",
          "target": "laptop_home",
          "on_complete": [
            {
              "world_event": "cinematic:laptop_closeup",
              "text": "The unfinished product: OctOpus Forecast. A login screen and a forecasting dashboard that half works."
            }
          ],
          "next": "@complete"
        }
      ],
      "on_complete": [
        {
          "set_fact": "opening_done"
        }
      ],
      "recovery_hint": ""
    },
