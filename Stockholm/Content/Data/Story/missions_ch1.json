            {
              "set_fact": "demo_recovered"
            },
            {
              "add_stat": "product_quality",
              "value": 3
            }
          ],
          "on_fail": [
            {
              "set_fact": "demo_crashed_twice"
            },
            {
              "add_stat": "wellbeing",
              "value": -4
            }
          ],
          "fail_next": "o7",
          "next": "o7"
        },
        {
          "id": "o7",
          "type": "talk",
          "text": "Hear Elin's verdict",
          "target": "elin",
          "dialogue": "elin_after_demo",
          "next_if": [
