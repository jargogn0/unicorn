        {
          "id": "o1",
          "type": "interact",
          "text": "Write the proposal on your laptop",
          "target": "laptop_home",
          "next": "o2"
        },
        {
          "id": "o2",
          "type": "decision",
          "text": "Set your price per location, per month",
          "target": "",
          "options": [
            {
              "id": "low",
              "text": "1 490 SEK — easy yes, thin margin",
              "effects": [
                {
                  "set_fact": "price_per_location",
