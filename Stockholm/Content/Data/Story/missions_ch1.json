    {
      "id": "m03_first_payment",
      "chapter": 1,
      "title": "First Payment",
      "summary": "Set a price, choose how to get paid, negotiate, and see real money arrive — just in time for rent, or not.",
      "giver": "noor",
      "auto_start": true,
      "prerequisites": {
        "any": [
          {
            "fact": "pilot_agreed"
          },
          {
            "fact": "proposal_requested"
