            }
          ],
          "fail_next": "o2_drive_late",
          "next": "o3",
          "deadline_anchor": "mission",
          "deadline_day_offset": 1
        },
        {
          "id": "o2_drive_late",
          "type": "drive",
          "text": "You're late. Get to Mälarbröd anyway",
          "target": "office_malarbrod_parking",
          "next": "o3"
        },
        {
          "id": "o2_walk",
          "type": "reach",
          "text": "Get to Mälarbröd on Hantverkargatan by 10:00",
          "target": "office_malarbrod",
          "deadline": "10:00",
          "on_fail": [
            {
              "set_fact": "late_to_pitch"
            },
            {
              "rel": "elin",
              "trust": -6
            }
          ],
          "fail_next": "o2_walk_late",
          "next": "o3",
          "deadline_anchor": "mission",
          "deadline_day_offset": 1
        },
        {
          "id": "o2_walk_late",
          "type": "reach",
          "text": "You're late. Get to Mälarbröd anyway",
          "target": "office_malarbrod",
          "next": "o3"
        },
